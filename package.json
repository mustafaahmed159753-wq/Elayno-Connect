{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "cross-env NODE_ENV=production node dist/server.cjs",
    "start:https": "cross-env NODE_ENV=production USE_HTTPS=true node dist/server.cjs",
    "certs": "node generate-certs.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "generate:pdf": "node scripts/generate-features-pdf.mjs",
    "package:release": "node scripts/build-release-package.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/archiver": "^8.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "archiver": "^8.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "ldapts": "^9.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mssql": "^12.7.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "selfsigned": "^5.5.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
